# ============================================
# docker-compose 环境变量 (复制为 .env 后填写真实值)
# cp .env.example .env
#
# 注意: 不要加引号! Docker Compose 会把引号当作值的一部分
# 正确: MYSQL_ROOT_PASSWORD=MyP@ss)word
# 错误: MYSQL_ROOT_PASSWORD="MyP@ss)word"
# ============================================

# MySQL
MYSQL_ROOT_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=yw_agent_portal
